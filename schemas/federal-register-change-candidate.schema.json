{
  "$defs": {
    "FederalRegisterAction": {
      "enum": [
        "amend",
        "correct",
        "delay_effective_date",
        "redesignate",
        "remove",
        "withdraw",
        "unknown"
      ],
      "title": "FederalRegisterAction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Candidate extraction of one Federal Register change instruction.",
  "properties": {
    "action": {
      "$ref": "#/$defs/FederalRegisterAction"
    },
    "affected_citations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Affected Citations",
      "type": "array"
    },
    "applicability_authority": {
      "const": "none",
      "default": "none",
      "title": "Applicability Authority",
      "type": "string"
    },
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "compliance_authority": {
      "const": "none",
      "default": "none",
      "title": "Compliance Authority",
      "type": "string"
    },
    "document_number": {
      "minLength": 1,
      "title": "Document Number",
      "type": "string"
    },
    "effective_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Effective Date"
    },
    "evidence_id": {
      "minLength": 1,
      "title": "Evidence Id",
      "type": "string"
    },
    "evidence_role": {
      "const": "federal_register_change",
      "default": "federal_register_change",
      "title": "Evidence Role",
      "type": "string"
    },
    "extraction_state": {
      "const": "source_extraction_candidate",
      "default": "source_extraction_candidate",
      "title": "Extraction State",
      "type": "string"
    },
    "interpretation_authority": {
      "const": "none",
      "default": "none",
      "title": "Interpretation Authority",
      "type": "string"
    },
    "operational_authority": {
      "const": "none",
      "default": "none",
      "title": "Operational Authority",
      "type": "string"
    },
    "parser_config_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Parser Config Sha256",
      "type": "string"
    },
    "parser_identity": {
      "default": "federal-register-change-candidate",
      "minLength": 1,
      "title": "Parser Identity",
      "type": "string"
    },
    "parser_version": {
      "const": 1,
      "default": 1,
      "title": "Parser Version",
      "type": "integer"
    },
    "publication_date": {
      "format": "date",
      "title": "Publication Date",
      "type": "string"
    },
    "raw_instruction": {
      "minLength": 1,
      "title": "Raw Instruction",
      "type": "string"
    },
    "raw_instruction_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Raw Instruction Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_artifact_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Artifact Sha256",
      "type": "string"
    },
    "source_locator": {
      "minLength": 1,
      "title": "Source Locator",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "evidence_id",
    "source_artifact_sha256",
    "document_number",
    "publication_date",
    "effective_date",
    "action",
    "affected_citations",
    "source_locator",
    "raw_instruction",
    "raw_instruction_sha256",
    "parser_config_sha256"
  ],
  "title": "FederalRegisterChangeCandidate",
  "type": "object"
}
