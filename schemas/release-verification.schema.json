{
  "$defs": {
    "ReleaseArtifact": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[^/\\\\]+$",
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "sha256",
        "size_bytes"
      ],
      "title": "ReleaseArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ReleaseArtifact"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "candidate_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Candidate Commit",
      "type": "string"
    },
    "package_name": {
      "const": "oscillink-safety-ops",
      "title": "Package Name",
      "type": "string"
    },
    "package_version": {
      "minLength": 1,
      "title": "Package Version",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "package_name",
    "package_version",
    "candidate_commit",
    "artifacts"
  ],
  "title": "ReleaseVerification",
  "type": "object"
}
