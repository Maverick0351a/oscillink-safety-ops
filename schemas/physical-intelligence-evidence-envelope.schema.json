{
  "additionalProperties": false,
  "description": "Portable identity and provenance for one read-only platform artifact.",
  "properties": {
    "access_mode": {
      "const": "read_only",
      "default": "read_only",
      "title": "Access Mode",
      "type": "string"
    },
    "adapter_config_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Adapter Config Sha256",
      "type": "string"
    },
    "adapter_id": {
      "minLength": 1,
      "title": "Adapter Id",
      "type": "string"
    },
    "adapter_version": {
      "minLength": 1,
      "title": "Adapter Version",
      "type": "string"
    },
    "artifact_type": {
      "minLength": 1,
      "title": "Artifact Type",
      "type": "string"
    },
    "asset_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Asset Ids",
      "type": "array"
    },
    "content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "content_treatment": {
      "const": "untrusted_data",
      "default": "untrusted_data",
      "title": "Content Treatment",
      "type": "string"
    },
    "episode_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Episode Id"
    },
    "missing_fields": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "payload_ref": {
      "minLength": 1,
      "title": "Payload Ref",
      "type": "string"
    },
    "platform_id": {
      "minLength": 1,
      "title": "Platform Id",
      "type": "string"
    },
    "platform_version": {
      "minLength": 1,
      "title": "Platform Version",
      "type": "string"
    },
    "provenance_refs": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Provenance Refs",
      "type": "array"
    },
    "run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "simulation_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Simulation Id"
    },
    "source_ref": {
      "minLength": 1,
      "title": "Source Ref",
      "type": "string"
    },
    "source_revision": {
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "unsupported_fields": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unsupported Fields",
      "type": "array"
    }
  },
  "required": [
    "platform_id",
    "platform_version",
    "adapter_id",
    "adapter_version",
    "adapter_config_sha256",
    "artifact_type",
    "source_ref",
    "source_revision",
    "content_sha256",
    "observed_at",
    "payload_ref"
  ],
  "title": "PhysicalIntelligenceEvidenceEnvelope",
  "type": "object"
}
