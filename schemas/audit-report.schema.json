{
  "$defs": {
    "AuditFinding": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "$ref": "#/$defs/Citation"
        },
        "constraint_id": {
          "title": "Constraint Id",
          "type": "string"
        },
        "contributing_states": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FindingState"
          },
          "title": "Contributing States",
          "type": "array"
        },
        "evidence_key": {
          "title": "Evidence Key",
          "type": "string"
        },
        "related_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Ids",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/FindingState"
        }
      },
      "required": [
        "constraint_id",
        "evidence_key",
        "state",
        "citation"
      ],
      "title": "AuditFinding",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "quote_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Quote Sha256",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "locator",
        "quote_sha256"
      ],
      "title": "Citation",
      "type": "object"
    },
    "EvidenceEnvelopeBinding": {
      "additionalProperties": false,
      "properties": {
        "adapter_config_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Adapter Config Sha256",
          "type": "string"
        },
        "adapter_id": {
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version": {
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "content_byte_count": {
          "exclusiveMinimum": 0,
          "title": "Content Byte Count",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "platform_id": {
          "minLength": 1,
          "title": "Platform Id",
          "type": "string"
        },
        "platform_version": {
          "minLength": 1,
          "title": "Platform Version",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "platform_id",
        "platform_version",
        "adapter_id",
        "adapter_version",
        "adapter_config_sha256",
        "artifact_type",
        "source_ref",
        "source_revision",
        "content_sha256",
        "content_byte_count",
        "observed_at",
        "task_id"
      ],
      "title": "EvidenceEnvelopeBinding",
      "type": "object"
    },
    "FindingState": {
      "enum": [
        "matched",
        "missing_evidence",
        "asset_mismatch",
        "revision_stale",
        "source_conflict",
        "ambiguous",
        "unreadable",
        "unsupported_interpretation",
        "requires_authorized_review",
        "prohibited_condition_evidence_present",
        "prohibited_condition_evidence_not_declared"
      ],
      "title": "FindingState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "envelope": {
      "$ref": "#/$defs/EvidenceEnvelopeBinding"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/AuditFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "packet_id": {
      "title": "Packet Id",
      "type": "string"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "packet_id",
    "plan_id",
    "policy_sha256",
    "envelope",
    "findings"
  ],
  "title": "AuditReport",
  "type": "object"
}
