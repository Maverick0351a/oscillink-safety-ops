{
  "$defs": {
    "IncidentEvent": {
      "additionalProperties": false,
      "description": "One immutable, non-authoritative timeline entry.",
      "properties": {
        "event_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "title": "Event Id",
          "type": "string"
        },
        "event_kind": {
          "enum": [
            "observation_recorded",
            "decision_recorded",
            "request_recorded",
            "acknowledgment_observed",
            "configuration_fault",
            "source_fault"
          ],
          "title": "Event Kind",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "operational_authority": {
          "const": "none",
          "default": "none",
          "title": "Operational Authority",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "summary": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "occurred_at",
        "event_kind",
        "record_sha256",
        "summary"
      ],
      "title": "IncidentEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Ordered incident evidence bound to exact configuration, inputs, and outputs.",
  "properties": {
    "authority_state": {
      "const": "incident_evidence_only",
      "default": "incident_evidence_only",
      "title": "Authority State",
      "type": "string"
    },
    "configuration_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Configuration Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_sha256": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Decision Sha256",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/IncidentEvent"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Events",
      "type": "array"
    },
    "input_sha256": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Input Sha256",
      "type": "array"
    },
    "operational_authority": {
      "const": "none",
      "default": "none",
      "title": "Operational Authority",
      "type": "string"
    },
    "request_sha256": {
      "default": [],
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Request Sha256",
      "type": "array"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stopping_claim": {
      "const": "not_established",
      "default": "not_established",
      "title": "Stopping Claim",
      "type": "string"
    },
    "timeline_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Timeline Id",
      "type": "string"
    }
  },
  "required": [
    "timeline_id",
    "run_id",
    "created_at",
    "configuration_sha256",
    "input_sha256",
    "decision_sha256",
    "events"
  ],
  "title": "IncidentTimeline",
  "type": "object"
}
