{
  "additionalProperties": false,
  "description": "Production-originated command intent, accepted only as untrusted observation.",
  "properties": {
    "authority_state": {
      "const": "untrusted_observation",
      "default": "untrusted_observation",
      "title": "Authority State",
      "type": "string"
    },
    "command_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Command Id",
      "type": "string"
    },
    "command_kind": {
      "enum": [
        "idle",
        "motion_requested",
        "motion_cancel_requested"
      ],
      "title": "Command Kind",
      "type": "string"
    },
    "configuration_authority": {
      "const": "none",
      "default": "none",
      "title": "Configuration Authority",
      "type": "string"
    },
    "content_treatment": {
      "const": "untrusted_data",
      "default": "untrusted_data",
      "title": "Content Treatment",
      "type": "string"
    },
    "evidence_suppression_authority": {
      "const": "none",
      "default": "none",
      "title": "Evidence Suppression Authority",
      "type": "string"
    },
    "frame_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frame Id"
    },
    "input_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "motion_requested": {
      "title": "Motion Requested",
      "type": "boolean"
    },
    "observation_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Observation Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "operational_authority": {
      "const": "none",
      "default": "none",
      "title": "Operational Authority",
      "type": "string"
    },
    "output_authority": {
      "const": "none",
      "default": "none",
      "title": "Output Authority",
      "type": "string"
    },
    "program_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Program Id"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "reset_authority": {
      "const": "none",
      "default": "none",
      "title": "Reset Authority",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence_number": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Sequence Number",
      "type": "integer"
    },
    "source_domain": {
      "const": "production_ai",
      "default": "production_ai",
      "title": "Source Domain",
      "type": "string"
    },
    "source_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "run_id",
    "source_id",
    "sequence_number",
    "observed_at",
    "received_at",
    "input_sha256",
    "command_id",
    "command_kind",
    "motion_requested"
  ],
  "title": "CommandObservation",
  "type": "object"
}
