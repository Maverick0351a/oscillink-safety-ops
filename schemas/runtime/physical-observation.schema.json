{
  "additionalProperties": false,
  "description": "Independently sourced represented zone and machine state.",
  "properties": {
    "authority_state": {
      "const": "untrusted_observation",
      "default": "untrusted_observation",
      "title": "Authority State",
      "type": "string"
    },
    "calibration_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Calibration Sha256",
      "type": "string"
    },
    "configuration_authority": {
      "const": "none",
      "default": "none",
      "title": "Configuration Authority",
      "type": "string"
    },
    "content_treatment": {
      "const": "untrusted_data",
      "default": "untrusted_data",
      "title": "Content Treatment",
      "type": "string"
    },
    "evidence_suppression_authority": {
      "const": "none",
      "default": "none",
      "title": "Evidence Suppression Authority",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "motion_state": {
      "enum": [
        "stopped",
        "moving",
        "unknown",
        "contradictory"
      ],
      "title": "Motion State",
      "type": "string"
    },
    "observation_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Observation Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "occupancy": {
      "enum": [
        "clear",
        "present",
        "unknown",
        "contradictory"
      ],
      "title": "Occupancy",
      "type": "string"
    },
    "operational_authority": {
      "const": "none",
      "default": "none",
      "title": "Operational Authority",
      "type": "string"
    },
    "quality": {
      "enum": [
        "good",
        "degraded",
        "invalid",
        "missing",
        "contradictory"
      ],
      "title": "Quality",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "reset_authority": {
      "const": "none",
      "default": "none",
      "title": "Reset Authority",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence_number": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Sequence Number",
      "type": "integer"
    },
    "source_domain": {
      "const": "independent_physical_observation",
      "default": "independent_physical_observation",
      "title": "Source Domain",
      "type": "string"
    },
    "source_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Source Id",
      "type": "string"
    },
    "speed_mps": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Speed Mps"
    },
    "zone_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Zone Id",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "run_id",
    "source_id",
    "sequence_number",
    "observed_at",
    "received_at",
    "input_sha256",
    "zone_id",
    "occupancy",
    "motion_state",
    "speed_mps",
    "quality",
    "calibration_sha256"
  ],
  "title": "PhysicalObservation",
  "type": "object"
}
