{
  "additionalProperties": false,
  "description": "Untrusted represented dependency health; never proof of independence.",
  "properties": {
    "affected_source_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Affected Source Ids",
      "type": "array"
    },
    "authority_state": {
      "const": "untrusted_observation",
      "default": "untrusted_observation",
      "title": "Authority State",
      "type": "string"
    },
    "configuration_authority": {
      "const": "none",
      "default": "none",
      "title": "Configuration Authority",
      "type": "string"
    },
    "configuration_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Configuration Sha256",
      "type": "string"
    },
    "content_treatment": {
      "const": "untrusted_data",
      "default": "untrusted_data",
      "title": "Content Treatment",
      "type": "string"
    },
    "dependency_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Dependency Id",
      "type": "string"
    },
    "dependency_kind": {
      "enum": [
        "power",
        "network",
        "sensor",
        "clock",
        "compute",
        "software_update",
        "credentials",
        "enclosure_environment",
        "communications",
        "final_element"
      ],
      "title": "Dependency Kind",
      "type": "string"
    },
    "dependency_state": {
      "enum": [
        "healthy",
        "degraded",
        "failed",
        "missing",
        "contradictory"
      ],
      "title": "Dependency State",
      "type": "string"
    },
    "evidence_suppression_authority": {
      "const": "none",
      "default": "none",
      "title": "Evidence Suppression Authority",
      "type": "string"
    },
    "independence_state": {
      "const": "not_established",
      "default": "not_established",
      "title": "Independence State",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "observation_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Observation Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "operational_authority": {
      "const": "none",
      "default": "none",
      "title": "Operational Authority",
      "type": "string"
    },
    "output_authority": {
      "const": "none",
      "default": "none",
      "title": "Output Authority",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "reset_authority": {
      "const": "none",
      "default": "none",
      "title": "Reset Authority",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence_number": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Sequence Number",
      "type": "integer"
    },
    "source_domain": {
      "const": "independent_dependency_health",
      "default": "independent_dependency_health",
      "title": "Source Domain",
      "type": "string"
    },
    "source_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "run_id",
    "source_id",
    "sequence_number",
    "observed_at",
    "received_at",
    "input_sha256",
    "dependency_id",
    "dependency_kind",
    "dependency_state",
    "affected_source_ids",
    "configuration_sha256"
  ],
  "title": "SharedDependencyObservation",
  "type": "object"
}
