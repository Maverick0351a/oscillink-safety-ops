{
  "$defs": {
    "CommandAttributionRecord": {
      "additionalProperties": false,
      "description": "Bounded historical command identity used only for deterministic correlation.",
      "properties": {
        "command_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "title": "Command Id",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "motion_requested": {
          "title": "Motion Requested",
          "type": "boolean"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "operational_authority": {
          "const": "none",
          "default": "none",
          "title": "Operational Authority",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sequence_number": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Sequence Number",
          "type": "integer"
        }
      },
      "required": [
        "command_id",
        "sequence_number",
        "observed_at",
        "motion_requested",
        "input_sha256"
      ],
      "title": "CommandAttributionRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Persistent deterministic intervention and recovery state; never a command.",
  "properties": {
    "active_request_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Request Sha256"
    },
    "authority_state": {
      "const": "deterministic_supervisor_state",
      "default": "deterministic_supervisor_state",
      "title": "Authority State",
      "type": "string"
    },
    "command_history": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CommandAttributionRecord"
      },
      "maxItems": 256,
      "title": "Command History",
      "type": "array"
    },
    "configuration_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Configuration Sha256",
      "type": "string"
    },
    "consumed_command_attributions": {
      "default": [],
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Consumed Command Attributions",
      "type": "array"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "first_out_reason": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "First Out Reason",
      "type": "string"
    },
    "fresh_start_required": {
      "default": false,
      "title": "Fresh Start Required",
      "type": "boolean"
    },
    "input_sha256": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Input Sha256",
      "type": "array"
    },
    "latched": {
      "title": "Latched",
      "type": "boolean"
    },
    "motion_authority": {
      "const": "none",
      "default": "none",
      "title": "Motion Authority",
      "type": "string"
    },
    "operational_authority": {
      "const": "none",
      "default": "none",
      "title": "Operational Authority",
      "type": "string"
    },
    "output_state": {
      "default": "not_requested",
      "enum": [
        "not_requested",
        "request_pending",
        "acknowledged_unverified",
        "unresolved"
      ],
      "title": "Output State",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "reset_sequence": {
      "default": 0,
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Reset Sequence",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "State Id",
      "type": "string"
    },
    "supervisor_state": {
      "enum": [
        "initializing",
        "monitoring_normal",
        "monitoring_degraded",
        "intervention_requested",
        "intervention_latched",
        "stopped_unverified",
        "reset_not_permitted",
        "reset_ready",
        "rearm_pending",
        "recovery_pending"
      ],
      "title": "Supervisor State",
      "type": "string"
    }
  },
  "required": [
    "state_id",
    "run_id",
    "evaluated_at",
    "supervisor_state",
    "latched",
    "first_out_reason",
    "reason_codes",
    "configuration_sha256",
    "input_sha256"
  ],
  "title": "SupervisorStateRecord",
  "type": "object"
}
